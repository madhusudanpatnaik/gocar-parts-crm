# Copy to .env and fill in real values. Never commit .env.
#
# Every variable below is REQUIRED — the app throws at boot if one is missing,
# and `docker compose up` refuses to start. There are no fallback defaults on
# purpose: a missing secret should fail loudly, not silently connect somewhere
# unintended.

# --- Database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=
MYSQL_APP_PASSWORD=
MYSQL_DATABASE=

# --- Razorpay ---------------------------------------------------------------
# Test keys use the rzp_test_ prefix; live keys use rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Application ------------------------------------------------------------
# Optional; these fall back to sensible non-sensitive defaults.
APP_ENV=development
APP_BASE_URL=http://localhost
ADMIN_EMAIL=
